# Nu rula NICIODATĂ scripturi din folderul cu fișiere încărcate
php_flag engine off
<FilesMatch "(?i)\.(php|php3|php4|php5|php7|php8|phtml|phar|cgi|pl|py|asp|aspx|sh)$">
  Require all denied
</FilesMatch>
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8
