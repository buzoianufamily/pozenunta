# ---- Album nuntă: securitate & performanță ----
Options -Indexes

# Pagina de start
DirectoryIndex index.php

# ---- Adrese curate: /galerie în loc de /galerie.php ----
# Invitatul poate scrie adresa de mână, iar linkul arată mai îngrijit.
# Vechile adrese cu .php merg în continuare, ca să nu se strice nimic
# din ce a fost deja trimis pe WhatsApp.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # /galerie.php -> /galerie  (o singură adresă bună pentru fiecare pagină)
  RewriteCond %{THE_REQUEST} "\s/+(galerie|urari)\.php[\s?]" [NC]
  RewriteRule ^ /%1 [R=301,L]

  # /galerie -> galerie.php, pe tăcute
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(galerie|urari)/?$ $1.php [L]
</IfModule>

# Folderul „bin" (unde poți pune ffmpeg) nu se serveste niciodata prin web:
# programul de acolo e pentru server, nu pentru vizitatori.
<IfModule mod_rewrite.c>
  RewriteRule ^bin/ - [F,L]
</IfModule>

# Nu permite accesul direct la fișiere sensibile
<FilesMatch "(?i)(config\.php|functions\.php|partiale\.php)$">
  Require all denied
</FilesMatch>
<FilesMatch "(?i)\.(ini|log|sql|md|sh|bak)$">
  Require all denied
</FilesMatch>

# Uneltele de instalare și de diagnostic au fost șterse de pe server anume.
# Ele există însă mai departe în arhiva codului, iar site-ul se actualizează
# urcând folderul întreg — deci o singură re-urcare le-ar aduce înapoi fără
# ca cineva să bage de seamă. „info.php" arăta, printre altele, cookie-ul
# de sesiune al celui care îl deschidea. Regula de mai jos le ține închise
# chiar dacă fișierele ajung din nou pe server.
# Dacă vreodată chiar ai nevoie de „instalare.php" (baza de date stricată),
# pune un # la începutul celor trei rânduri, folosește-l, apoi scoate-l.
<FilesMatch "(?i)^(info|instalare|setup)\.php$">
  Require all denied
</FilesMatch>

# UTF-8
AddDefaultCharset UTF-8

# Cache pentru fișierele statice (poze, css, js)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png  "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/gif  "access plus 30 days"
  ExpiresByType video/mp4  "access plus 30 days"
  # filmele de pe iPhone (.mov) și cele de pe Android (.webm)
  ExpiresByType video/quicktime "access plus 30 days"
  ExpiresByType video/webm "access plus 30 days"
  ExpiresByType text/css   "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  # fonturile găzduite local nu se schimbă niciodată
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Comprimare text
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Câteva anteturi de securitate
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
